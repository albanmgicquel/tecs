local audio = require("tecs.audio")
local audiobackend = require("tecs.platform.audiobackend")
local fm = require("tecs.audio.fm")
local test = require("nupp.test")

local suite = {}

--- One call a test port received, as the port saw it.
local record Sent
    kind: string
    pairs: {integer}
    at: number
end

--- A backend with an FM chip that logs every write instead of rendering.
local record Harness
    backend: audiobackend.Backend
    commands: {audiobackend.Command}
    sent: {Sent}
    opened: {integer}
    chips: {string}
    closed: {integer}
    full: {boolean}
end

local function newHarness(available: boolean, withFm: boolean): Harness
    local commands: {audiobackend.Command} = {}
    local sent: {Sent} = {}
    local opened: {integer} = {}
    local chips: {string} = {}
    local closed: {integer} = {0}
    local full = {false}

    local function record(kind: string, pairs: {integer}, at: number): boolean
        if full[1] then
            return false
        end
        sent[#sent + 1] = new Sent(kind = kind, pairs = pairs, at = at)

        return true
    end

    local backend = audiobackend.silent()
    backend.available = available
    backend.submit = function(pending: {audiobackend.Command}, count: integer): nil
        for index = 1, count do
            local source = pending[index]
            local copy = audiobackend.newCommand()
            copy.kind = source.kind
            copy.handle = source.handle
            copy.flags = source.flags
            copy.gain = source.gain
            commands[#commands + 1] = copy
        end
    end
    if withFm then
        backend.openFm = function(handle: integer, chip: audiobackend.FmChip): (audiobackend.FmPort?, string?)
            opened[#opened + 1] = handle
            chips[#chips + 1] = chip

            return new audiobackend.FmPort(
                write = function(register: integer, value: integer, at: number): boolean
                    return record("write", {register, value}, at)
                end,
                writes = function(pairs: {integer}, count: integer, at: number): boolean
                    -- The list is the caller's, so the log keeps a copy.
                    local copy: {integer} = {}
                    for index = 1, 2 * count do
                        copy[index] = pairs[index]
                    end

                    return record("writes", copy, at)
                end,
                reset = function(at: number): boolean
                    return record("reset", {}, at)
                end,
                now = function(): number
                    return 2.5
                end,
                close = function(): nil
                    closed[1] = closed[1] + 1
                end
            )
        end
    end

    return new Harness(
        backend = backend,
        commands = commands,
        sent = sent,
        opened = opened,
        chips = chips,
        closed = closed,
        full = full
    )
end

local function lastCommand(harness: Harness, kind: integer): audiobackend.Command?
    for index = #harness.commands, 1, -1 do
        if harness.commands[index].kind == kind then
            return harness.commands[index]
        end
    end

    return nil
end

local function made(harness: Harness, options: fm.Options?): (audio.Audio, fm.Fm)
    local mixer = audio.newAudio({backend = harness.backend, maxVoices = 2})

    return mixer, assert(fm.new(mixer, options))
end

function suite.startsTheChipAsOneVoiceOfTheMixer(): nil
    local harness = newHarness(true, true)
    local mixer, chip = made(harness, {chip = "opl3", group = "music", gain = 0.5})
    test.equal(chip.rate, 49715)
    test.equal(chip.chip, "opl3")
    test.equal(harness.chips[1], "opl3")
    test.equal(mixer:sounding(), 1)
    mixer:update()
    local play = assert(lastCommand(harness, audiobackend.PLAY))
    test.equal(play.flags, audiobackend.SYNTH)
    test.equal(play.gain, 0.5)
    -- The chip was opened for the voice that started, before the start
    -- crossed, which is what hands it to the mixer.
    test.equal(harness.opened[1], play.handle)

    mixer:setGroupGain("music", 0.5)
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.SET_GAIN)).gain, 0.25)
    mixer:setGroupMuted("music", true)
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.SET_GAIN)).gain, 0)
    mixer:setGroupMuted("music", false)
    chip:setGain(1)
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.SET_GAIN)).gain, 0.5)
    mixer:pauseGroup("music")
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.PAUSE)).handle, play.handle)

    chip:destroy()
    chip:destroy()
    mixer:update()
    test.equal(assert(lastCommand(harness, audiobackend.STOP)).handle, play.handle)
    test.equal(harness.closed[1], 1)
    test.equal(mixer:sounding(), 0)
end

function suite.makesAnOpl2WhenNoChipIsNamed(): nil
    local harness = newHarness(true, true)
    local _mixer, chip = made(harness)
    test.equal(chip.chip, "opl2")
    test.equal(harness.chips[1], "opl2")
end

function suite.countsAgainstTheVoiceCeiling(): nil
    local harness = newHarness(true, true)
    local mixer = audio.newAudio({backend = harness.backend, maxVoices = 1})
    local first = assert(fm.new(mixer))
    local second, reason = fm.new(mixer)
    test.equal(second, nil)
    test.matches(assert(reason), "every voice is busy")
    first:destroy()
    test.assert(fm.new(mixer) ~= nil)
end

function suite.carriesWritesBatchesAndResetsToThePortWithTheirTimes(): nil
    local harness = newHarness(true, true)
    local _mixer, chip = made(harness, {chip = "opl3"})
    test.assert(chip:write(0x105, 0x01))
    test.assert(chip:write(0x1B0, 0x32, 0.25))
    test.assert(chip:writes({0xA0, 0x41, 0xB0, 0x32}, 1.5))
    test.assert(chip:writes({}))
    test.assert(chip:reset())
    test.assert(chip:reset(3))
    test.equal(#harness.sent, 5, "an empty batch reaches nothing")
    test.equal(harness.sent[1].kind, "write")
    test.equal(harness.sent[1].pairs[1], 0x105)
    test.equal(harness.sent[1].at, 0)
    test.equal(harness.sent[2].pairs[1], 0x1B0)
    test.equal(harness.sent[2].pairs[2], 0x32)
    test.equal(harness.sent[2].at, 0.25)
    test.equal(harness.sent[3].kind, "writes")
    test.equal(#harness.sent[3].pairs, 4)
    test.equal(harness.sent[3].pairs[3], 0xB0)
    test.equal(harness.sent[3].at, 1.5)
    test.equal(harness.sent[4].kind, "reset")
    test.equal(harness.sent[4].at, 0)
    test.equal(harness.sent[5].at, 3)
    test.equal(chip:now(), 2.5)
end

function suite.reportsAFullQueueAsAnUnqueuedWrite(): nil
    local harness = newHarness(true, true)
    local _mixer, chip = made(harness)
    harness.full[1] = true
    test.assert(not chip:write(0xB0, 0x20))
    test.assert(not chip:writes({0xB0, 0x20}))
    test.assert(not chip:reset())
    harness.full[1] = false

    -- A batch past the queue could never be taken, so it is refused here.
    local huge: {integer} = {}
    for index = 1, 4097 do
        huge[2 * index - 1] = 0xA0
        huge[2 * index] = index % 256
    end
    test.assert(not chip:writes(huge))
    huge[8193] = nil
    huge[8194] = nil
    test.assert(chip:writes(huge))
    test.equal(#harness.sent, 1)

    chip:destroy()
    test.assert(not chip:write(0xB0, 0x20), "a destroyed chip queues nothing")
    test.assert(not chip:writes({0xB0, 0x20}))
    test.assert(not chip:reset())
    test.equal(chip:now(), 0)
end

function suite.raisesForARegisterOrValueOutsideItsRange(): nil
    local harness = newHarness(true, true)
    local mixer, opl2 = made(harness)
    local opl3 = assert(fm.new(mixer, {chip = "opl3"}))
    test.raises(
        function(): nil
            opl2:write(0x100, 0)
        end,
        "opl2 register must be from 0x00 to 0xFF, got 0x100"
    )
    test.raises(
        function(): nil
            opl3:write(0x200, 0)
        end,
        "0x1FF"
    )
    test.raises(
        function(): nil
            opl2:write(-1, 0)
        end,
        "register"
    )
    test.raises(
        function(): nil
            opl2:write(0xB0, 256)
        end,
        "value must be from 0 to 255"
    )
    test.raises(
        function(): nil
            opl2:writes({0xB0})
        end,
        "alternate register and value"
    )
    -- One bad pair refuses the whole batch before any of it is sent.
    test.raises(
        function(): nil
            opl3:writes({0xA0, 0x41, 0x1B0, 0x300})
        end,
        "value"
    )
    test.equal(#harness.sent, 0)
    test.assert(opl3:write(0x1FF, 0xFF))
    test.raises(
        function(): nil
            fm.new(mixer, {chip = "opl4" as fm.Chip})
        end,
        "chip must be"
    )
end

function suite.acceptsEverythingSilentlyWithoutAnOutput(): nil
    -- A mixer with no output takes no voice, and its chip still answers
    -- every call, on a clock that never moves because nothing renders.
    local mixer = audio.newAudio({backend = audiobackend.silent()})
    local chip = assert(fm.new(mixer, {chip = "opl3"}))
    test.equal(mixer:sounding(), 0)
    test.assert(chip:write(0xB0, 0x20, 0.5))
    test.assert(chip:writes({0xA0, 0x41}))
    test.assert(chip:reset())
    test.equal(chip:now(), 0)
    chip:destroy()
end

function suite.takesAVoiceButRendersNothingOnABackendWithNoFm(): nil
    local harness = newHarness(true, false)
    local mixer, chip = made(harness)
    test.equal(mixer:sounding(), 1)
    test.assert(chip:write(0xB0, 0x20))
    test.equal(#harness.sent, 0)
    test.equal(chip:now(), 0)
end

--- Returns the native binding, or skips when `libtecsaudio` is not staged.
local function binding(): {[string]: any}
    local ok, loaded = pcall(require, "tecs.platform.audionative")
    if not ok then
        test.skip("libtecsaudio is not on the loader path: " .. tostring(loaded))
    end

    return loaded as {[string]: any}
end

function suite.crossesIntoTheNativeChipThroughTheBackend(): nil
    local backend = binding().openOffline(48000, 2, 8) as audiobackend.Backend?
    if backend == nil then
        test.skip("libtecsaudio did not open")
    end
    -- The offline backend reports no output, so a mixer would give the chip
    -- no voice; the port is opened directly to reach the library.
    local openFm = assert(assert(backend).openFm)
    for _, chip in ipairs({"opl2", "opl3"} as {audiobackend.FmChip}) do
        local port = assert(openFm(1, chip))
        test.assert(port.write(0xB0, 0x32, 0))
        test.assert(port.writes({0xA0, 0x41, 0xB0, 0x32}, 2, 0.1))
        test.assert(port.reset(0.2))
        test.equal(port.now(), 0)
        port.close()
        port.close()
        test.assert(not port.write(0xB0, 0x32, 0), "a closed port queues nothing")
    end
    assert(backend).close()
end

return suite
