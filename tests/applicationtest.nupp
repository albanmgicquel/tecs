local application = require("tecs.application")
local ecs = require("tecs.ecs")
local files = require("nupp.io.files")
local platformevents = require("tecs.platform.events")
local test = require("nupp.test")

local suite = {}

function suite.constructsInertThenRunsPluginBeforeStartup(): nil
    local pluginCalled = false
    local startupObserved = false
    local app = application.newApplication({
        plugin = function(exclusive running: application.Application): nil
            pluginCalled = true
            running.world:addSystem({
                phase = ecs.phases.Startup,
                run = function(_dt: number, exclusive _world: ecs.World): nil
                    startupObserved = pluginCalled
                end,
            })
        end,
    })

    test.assert(not pluginCalled)
    test.equal(app:getState(), "created")
    test.assert(app:init())

    test.assert(startupObserved)
    test.equal(app:getState(), "running")
end

function suite.namesAnApplicationIdentityWithoutReplacingOne(): nil
    -- `nupp.io.files` has no way to forget an identity, and the suites share a
    -- process, so this case names one and checks that a later application
    -- leaves it alone. The unnamed half is the default the engine ships.
    files.setApplicationIdentity("Ex Nihilo", "Starfarer")
    application.newApplication()
    local organization, named = files.applicationIdentity()
    test.equal(organization, "Ex Nihilo")
    test.equal(named, "Starfarer")

    files.setApplicationIdentity(application.DEFAULT_IDENTITY, application.DEFAULT_IDENTITY)
    const root, reason = files.dataPath()
    if root == nil then
        test.skip("this platform has no writable root: " .. tostring(reason))
    end
    test.assert((root as files.ApplicationPath):toString():find(application.DEFAULT_IDENTITY, 1, true) ~= nil)
end

function suite.deliversASealedEventBatchBeforeTheFrame(): nil
    local delivered: {string} = {}
    local seenByUpdate = 0
    local resizeWidth = 0
    local app = application.newApplication({
        onEvent = function(event: platformevents.Event, exclusive _running: application.Application): nil
            delivered[#delivered + 1] = event.kind
        end,
        plugin = function(exclusive running: application.Application): nil
            running.world:observe(0, platformevents.WindowResized, function(event: platformevents.ResizeEvent): nil
                resizeWidth = event.width
            end)
            running.world:addSystem({
                phase = ecs.phases.Ingress,
                run = function(_dt: number, exclusive _world: ecs.World): nil
                    seenByUpdate = #delivered
                end,
            })
        end,
    })
    app:init()

    local continues = app:iterate(0.25, {platformevents.resized(1280, 720), platformevents.focused(true),})

    test.assert(continues)
    test.equal(table.concat(delivered, ","), "windowResized,windowFocusGained")
    test.equal(resizeWidth, 1280)
    test.equal(seenByUpdate, 2)
    test.equal(app.elapsed, 0.25)
    test.equal(app.frame, 1)
end

function suite.honorsQuitRequestsFromEvents(): nil
    local app = application.newApplication({
        onEvent = function(_event: platformevents.Event, exclusive _running: application.Application): nil
        end,
    })
    app:init()

    test.assert(not app:iterate(0.1, {platformevents.closeRequested(1)}))

    test.equal(app.frame, 0)
    test.equal(app.elapsed, 0)
end

function suite.pausesSimulationButNotHostIterations(): nil
    local app = application.newApplication()
    app:init()
    app:setSuspended(true)

    test.assert(app:iterate(0.5))

    test.equal(app.frame, 1)
    test.equal(app.elapsed, 0)
    test.equal(app.world:fixedStepCount(), 0)
end

function suite.containsAFrameCrashAndResumesInDebugMode(): nil
    local shouldFail = true
    local calls = 0
    local app = application.newApplication({
        debug = true,
        plugin = function(exclusive running: application.Application): nil
            running.world:addSystem({
                phase = ecs.phases.Update,
                run = function(_dt: number, exclusive _world: ecs.World): nil
                    calls = calls + 1
                    if shouldFail then
                        error("expected frame crash")
                    end
                end,
            })
        end,
    })
    app:init()

    test.assert(app:iterate(0.1))
    test.assert(app:crashed() ~= nil)
    test.assert(app:iterate(0.1))
    test.equal(calls, 1)

    shouldFail = false
    test.assert(app:clearCrash())
    test.assert(app:iterate(0.1))
    test.equal(calls, 2)
end

function suite.refusesCrashRecoveryOutsideDebugMode(): nil
    local app = application.newApplication({
        plugin = function(exclusive _running: application.Application): nil
            error("expected plugin crash")
        end,
    })
    app:init()

    local resumed, reason = app:clearCrash()

    test.assert(not resumed)
    test.equal(reason, "application debug mode is disabled")
end

function suite.stopsAtTheConfiguredFrameLimit(): nil
    local app = application.newApplication({debugMaxFrames = 2})
    app:init()

    test.assert(app:iterate(0))
    test.assert(not app:iterate(0))
    test.equal(app.frame, 2)
end

function suite.runsShutdownOnceAfterAStartupFailure(): nil
    local shutdownCalls = 0
    local app = application.newApplication({
        plugin = function(exclusive running: application.Application): nil
            running.world:addSystem({
                phase = ecs.phases.Shutdown,
                run = function(_dt: number, exclusive _world: ecs.World): nil
                    shutdownCalls = shutdownCalls + 1
                end,
            })
            error("expected startup failure")
        end,
    })
    app:init()

    test.assert(app:shutdown())
    test.assert(app:shutdown())

    test.equal(shutdownCalls, 1)
    test.equal(app:getState(), "stopped")
end

function suite.rejectsInvalidHostLifecycleCalls(): nil
    local app = application.newApplication()
    test.raises(
        function(): nil
            app:iterate(0)
        end,
        "created"
    )
    app:init()
    test.raises(
        function(): nil
            app:init()
        end,
        "already running"
    )
    test.raises(
        function(): nil
            app:iterate(-1)
        end,
        "negative number"
    )
    test.raises(
        function(): nil
            application.newApplication({debugMaxFrames = 0})
        end,
        "positive integer"
    )
end

--- Builds a running application whose one Update system records each frame's
--- delta and whether Space was pressed on it.
local function recorder(): (application.Application, {number}, {boolean})
    local deltas: {number} = {}
    local pressed: {boolean} = {}
    local app = application.newApplication({
        plugin = function(exclusive running: application.Application): nil
            const input = running.input
            running.world:addSystem({
                name = "test.application.recorder",
                phase = ecs.phases.Update,
                run = function(dt: number): nil
                    deltas[#deltas + 1] = dt
                    pressed[#pressed + 1] = input:keyPressed("Space")
                end,
            })
        end,
    })
    app:init()

    return app, deltas, pressed
end

local function space(down: boolean): platformevents.Event
    return platformevents.key(down, "Space", " ", nil, 0, false, 0)
end

function suite.deliversAQueuedEventAsAnEdgeOfTheNextFrame(): nil
    local app, _, pressed = recorder()
    app:queueEvent(space(true))
    test.equal(app:pendingEvents(), 1)
    test.assert(not app.input:keyDown("Space"))

    app:iterate(1 / 60, nil)
    test.assert(pressed[1])
    test.equal(app:pendingEvents(), 0)

    -- The edge lasts one frame, and the key stays down until it comes up.
    app:iterate(1 / 60, nil)
    test.assert(not pressed[2])
    test.assert(app.input:keyDown("Space"))
    app:queueEvent(space(false))
    app:iterate(1 / 60, nil)
    test.assert(app.input:keyReleased("Space"))
    app:shutdown()
end

function suite.deliversQueuedEventsAfterTheHostBatch(): nil
    local order: {string} = {}
    local app = application.newApplication({
        onEvent = function(event: platformevents.Event, exclusive _running: application.Application): nil
            order[#order + 1] = event.kind
        end,
    })
    app:init()
    app:queueEvent(platformevents.text("queued", 0))
    app:iterate(1 / 60, {platformevents.focused(true, 0)})
    test.equal(#order, 2)
    test.equal(order[1], "windowFocusGained")
    test.equal(order[2], "textInput")
    app:shutdown()
end

function suite.holdsAPausedSimulationAndRunsGrantedFramesOnAFixedDelta(): nil
    local app, deltas, pressed = recorder()
    app:iterate(0.5, nil)
    test.equal(#deltas, 1)

    app:pause()
    test.assert(app.paused)
    local frame, elapsed = app.frame, app.elapsed
    app:queueEvent(space(true))
    -- Held turns run nothing, advance nothing, and keep the events.
    test.assert(app:iterate(0.5, {platformevents.focused(true, 0)}))
    test.assert(app:iterate(0.5, nil))
    test.equal(#deltas, 1)
    test.equal(app.frame, frame)
    test.equal(app.elapsed, elapsed)
    test.equal(app:pendingEvents(), 2)
    test.assert(not app.window:hasFocus())

    app:step(2, 0.25)
    test.equal(app:pendingSteps(), 2)
    test.equal(app:stepDelta(), 0.25)
    app:iterate(0.5, nil)
    test.equal(#deltas, 2)
    test.equal(deltas[2], 0.25)
    test.assert(pressed[2])
    test.assert(app.window:hasFocus())
    app:iterate(9, nil)
    test.equal(deltas[3], 0.25)
    test.assert(not pressed[3])
    test.equal(app.frame, frame + 2)
    test.equal(app.elapsed, elapsed + 0.5)
    test.equal(app:pendingSteps(), 0)

    -- Granted frames used up, the clock holds again.
    app:iterate(0.5, nil)
    test.equal(#deltas, 3)

    -- Resuming discards a grant and returns to the host's delta.
    app:step(5, 0.1)
    app:resume()
    test.assert(not app.paused)
    test.equal(app:pendingSteps(), 0)
    app:iterate(0.5, nil)
    test.equal(deltas[4], 0.5)
    app:shutdown()
end

function suite.honorsAQuitWhilePaused(): nil
    local app = recorder()
    app:pause()
    test.assert(not app:iterate(1 / 60, {platformevents.quit(0)}))
    test.assert(app.quitRequested)
    app:shutdown()
end

function suite.refusesToStepARunningClockOrAnInvalidGrant(): nil
    local app = recorder()
    test.raises(
        function(): nil
            app:step(1, 1 / 60)
        end,
        "not paused"
    )
    app:pause()
    test.raises(
        function(): nil
            app:step(0, 1 / 60)
        end,
        "positive integer"
    )
    test.raises(
        function(): nil
            app:step(1, 0)
        end,
        "positive finite"
    )
    test.raises(
        function(): nil
            app:step(1, math.huge)
        end,
        "positive finite"
    )
    app:shutdown()
end

function suite.boundsTheEventsAPausedApplicationHolds(): nil
    local app = recorder()
    app:pause()
    local batch: {platformevents.Event} = {}
    for index = 1, 1500 do
        batch[index] = platformevents.text(tostring(index), 0)
    end
    app:iterate(1 / 60, batch)
    test.equal(app:pendingEvents(), 1024)
    app:shutdown()
end

return suite
